<Project>
  <!-- Shared CI needs reviewed sources before its architecture suite. Local developers
       initialize the direct gitlinks explicitly using the README instructions. -->
  <Target Name="InitializeReviewedSourceGitlinks" BeforeTargets="Restore"
          Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(SolutionFileName)' == 'Hexalith.Works.slnx' and Exists('$(MSBuildThisFileDirectory).git')">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)scripts/initialize-reviewed-source-gitlinks.sh&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="High" />
  </Target>
</Project>
