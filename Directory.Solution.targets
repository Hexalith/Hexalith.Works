<Project>
  <!-- The AppHost and the solution otherwise build the same projects at the same time and lock output files,
       including the Aspire CLI bundle setup. Build each solution project to completion, then leave the
       default solution build with nothing left to schedule in parallel. -->
  <Target Name="BuildSolutionProjectsSerially" BeforeTargets="Build">
    <MSBuild
      Projects="@(ProjectReference)"
      BuildInParallel="False"
      Properties="BuildInParallel=false;RestoreBuildInParallel=false" />
    <ItemGroup>
      <ProjectReference Remove="@(ProjectReference)" />
    </ItemGroup>
  </Target>
</Project>
