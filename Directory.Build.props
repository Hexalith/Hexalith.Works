<Project>

  <PropertyGroup>
    <!-- Detect only root-declared sibling modules under references/; nested submodules are intentionally not required. -->
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Tenants\src\Hexalith.Tenants.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithPartiesRoot Condition="'$(HexalithPartiesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Parties\src\Hexalith.Parties.Client')">$(MSBuildThisFileDirectory)references\Hexalith.Parties</HexalithPartiesRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Platform\src\Hexalith.Platform.Identity')">$(MSBuildThisFileDirectory)references\Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Platform\src\Hexalith.Platform.Identity')">$(MSBuildThisFileDirectory)..\Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPlatformRoot Condition="'$(HexalithPlatformRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.Platform</HexalithPlatformRoot>
    <HexalithPolymorphicSerializationsRoot Condition="'$(HexalithPolymorphicSerializationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.PolymorphicSerializations\src\libraries\Hexalith.PolymorphicSerializations')">$(MSBuildThisFileDirectory)references\Hexalith.PolymorphicSerializations</HexalithPolymorphicSerializationsRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Tenants\src\Hexalith.Tenants.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithPartiesRoot Condition="'$(HexalithPartiesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Parties\src\Hexalith.Parties.Client')">$(MSBuildThisFileDirectory)..\Hexalith.Parties</HexalithPartiesRoot>
    <HexalithPolymorphicSerializationsRoot Condition="'$(HexalithPolymorphicSerializationsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.PolymorphicSerializations\src\libraries\Hexalith.PolymorphicSerializations')">$(MSBuildThisFileDirectory)..\Hexalith.PolymorphicSerializations</HexalithPolymorphicSerializationsRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithPartiesRoot Condition="'$(HexalithPartiesRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.Parties</HexalithPartiesRoot>
    <HexalithPolymorphicSerializationsRoot Condition="'$(HexalithPolymorphicSerializationsRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.PolymorphicSerializations</HexalithPolymorphicSerializationsRoot>

    <!-- Preserve caller intent before defaults are applied so the validation target can reject every
         contradictory or non-boolean mode instead of silently normalizing it. -->
    <RequestedUseHexalithProjectReferences>$(UseHexalithProjectReferences)</RequestedUseHexalithProjectReferences>
    <RequestedUseNuGetDeps>$(UseNuGetDeps)</RequestedUseNuGetDeps>
    <RequestedHexalithEventStoreFromSource>$(HexalithEventStoreFromSource)</RequestedHexalithEventStoreFromSource>
    <RequestedHexalithPolymorphicSerializationsFromSource>$(HexalithPolymorphicSerializationsFromSource)</RequestedHexalithPolymorphicSerializationsFromSource>

    <!-- Local Debug builds use root-declared sibling sources. Release and configuration-free
         restores use the centrally pinned NuGet packages so CI restores the same graph it builds. -->
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'true'">false</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'false'">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == 'Debug'">true</UseHexalithProjectReferences>
    <!-- A configuration-free evaluation (a bare `dotnet build`, or design-time evaluation) would otherwise
         resolve package references while emitting Debug output. Record that the mode was defaulted, pick the
         Release-consistent package mode explicitly, and warn below so the mismatch is never silent. -->
    <HexalithDependencyModeDefaulted Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == '' and $(MSBuildProjectName.StartsWith('Hexalith.Works'))">true</HexalithDependencyModeDefaulted>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == ''">false</UseHexalithProjectReferences>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == '' and '$(UseHexalithProjectReferences)' == 'true'">false</UseNuGetDeps>
    <UseNuGetDeps Condition="'$(UseNuGetDeps)' == ''">true</UseNuGetDeps>
    <HexalithEventStoreFromSource Condition="'$(HexalithEventStoreFromSource)' == ''">$(UseHexalithProjectReferences)</HexalithEventStoreFromSource>
    <HexalithPolymorphicSerializationsFromSource Condition="'$(HexalithPolymorphicSerializationsFromSource)' == ''">$(UseHexalithProjectReferences)</HexalithPolymorphicSerializationsFromSource>
    <HexalithEventStoreVersion Condition="'$(HexalithEventStoreVersion)' == ''">3.128.4</HexalithEventStoreVersion>
    <WorksSdkCandidateFeed Condition="'$(WorksSdkCandidateFeed)' == ''">$(MSBuildThisFileDirectory).artifacts/story-4-15/feed</WorksSdkCandidateFeed>
    <WorksPlatformCandidateFeed Condition="'$(WorksPlatformCandidateFeed)' == ''">$(MSBuildThisFileDirectory).artifacts/story-4-14/feed</WorksPlatformCandidateFeed>
    <!-- Candidate archives are admitted only by an explicit verification invocation. Merely leaving a
         historical feed directory on disk must not change an ordinary restore's producer authority. -->
    <RestoreAdditionalProjectSources Condition="'candidate:$(WorksAllowLocalEventStoreCandidate)' == 'candidate:true' and Exists('$(WorksPlatformCandidateFeed)')">$(RestoreAdditionalProjectSources);$(WorksPlatformCandidateFeed)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="'candidate:$(WorksAllowLocalEventStoreCandidate)' == 'candidate:true' and Exists('$(WorksSdkCandidateFeed)')">$(RestoreAdditionalProjectSources);$(WorksSdkCandidateFeed)</RestoreAdditionalProjectSources>
    <!-- Candidate admission must not populate the ordinary public-package cache. An explicit
         RestorePackagesPath remains the caller's isolation choice. -->
    <RestorePackagesPath Condition="'candidate:$(WorksAllowLocalEventStoreCandidate)' == 'candidate:true' and '$(RestorePackagesPath)' == ''">$(MSBuildThisFileDirectory).artifacts/sdk-candidate-packages</RestorePackagesPath>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Hexalith.Builds ci-cd-standards.md (Dependency Auditing) requires NU1901-NU1904 to stay out of
         warnings-as-errors so a transitive advisory that cannot be upgraded immediately does not block CI,
         while still surfacing in build logs. Waive an individual advisory with NuGetAuditSuppress. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU5118;NU5128</NoWarn>

    <!-- Published packages declare RepositoryUrl, so ship debugging symbols and deterministic source links. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>

    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Works</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Works</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Hexalith work item domain module for .NET</Description>
    <PackageTags>works;work-items;dapr;eventsourcing;cqrs;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Reject invalid caller values, equal mode switches (true/true or false/false), and source flags that
       disagree with the selected mode. These checks run for restore/package collection as well as compile. -->
  <Target Name="ValidateHexalithDependencyMode" BeforeTargets="CollectPackageReferences;CoreCompile">
    <Error
      Condition="'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:' and 'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:true' and 'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:false'"
      Code="HXW0003"
      Text="WorksAllowLocalEventStoreCandidate must be exactly true or false when supplied." />
    <!-- Read the literal committed pin so ambient environment variables and command-line overrides
         cannot silently change Release producer identity. Explicit candidate verification opts in. -->
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)Directory.Packages.props"
             Query="/Project/PropertyGroup/HexalithEventStoreVersion/text()"
             Condition="'$(Configuration)' == 'Release' and 'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:true'">
      <Output TaskParameter="Result" PropertyName="_WorksDeclaredEventStoreVersion" />
    </XmlPeek>
    <Error
      Condition="'$(Configuration)' == 'Release' and 'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:true' and ('$(HexalithEventStoreVersion)' != '$(_WorksDeclaredEventStoreVersion)' or '$(_WorksDeclaredEventStoreVersion)' == '')"
      Code="HXW0003"
      Text="Release requires the committed EventStore pin '$(_WorksDeclaredEventStoreVersion)'; received '$(HexalithEventStoreVersion)'. For isolated candidate verification, explicitly set WorksAllowLocalEventStoreCandidate=true." />
    <Error
      Condition="'$(RequestedUseHexalithProjectReferences)' != '' and '$(RequestedUseHexalithProjectReferences)' != 'true' and '$(RequestedUseHexalithProjectReferences)' != 'false'"
      Code="HXW0001"
      Text="UseHexalithProjectReferences must be exactly true or false when supplied; received '$(RequestedUseHexalithProjectReferences)'." />
    <Error
      Condition="'$(RequestedUseNuGetDeps)' != '' and '$(RequestedUseNuGetDeps)' != 'true' and '$(RequestedUseNuGetDeps)' != 'false'"
      Code="HXW0001"
      Text="UseNuGetDeps must be exactly true or false when supplied; received '$(RequestedUseNuGetDeps)'." />
    <Error
      Condition="'$(RequestedHexalithEventStoreFromSource)' != '' and '$(RequestedHexalithEventStoreFromSource)' != 'true' and '$(RequestedHexalithEventStoreFromSource)' != 'false'"
      Code="HXW0001"
      Text="HexalithEventStoreFromSource must be exactly true or false when supplied; received '$(RequestedHexalithEventStoreFromSource)'." />
    <Error
      Condition="'$(RequestedHexalithPolymorphicSerializationsFromSource)' != '' and '$(RequestedHexalithPolymorphicSerializationsFromSource)' != 'true' and '$(RequestedHexalithPolymorphicSerializationsFromSource)' != 'false'"
      Code="HXW0001"
      Text="HexalithPolymorphicSerializationsFromSource must be exactly true or false when supplied; received '$(RequestedHexalithPolymorphicSerializationsFromSource)'." />
    <Error
      Condition="'$(UseHexalithProjectReferences)' != 'true' and '$(UseHexalithProjectReferences)' != 'false'"
      Code="HXW0001"
      Text="The final UseHexalithProjectReferences value must be exactly true or false; received '$(UseHexalithProjectReferences)'." />
    <Error
      Condition="'$(UseNuGetDeps)' != 'true' and '$(UseNuGetDeps)' != 'false'"
      Code="HXW0001"
      Text="The final UseNuGetDeps value must be exactly true or false; received '$(UseNuGetDeps)'." />
    <Error
      Condition="'$(HexalithEventStoreFromSource)' != 'true' and '$(HexalithEventStoreFromSource)' != 'false'"
      Code="HXW0001"
      Text="The final HexalithEventStoreFromSource value must be exactly true or false; received '$(HexalithEventStoreFromSource)'." />
    <Error
      Condition="'$(HexalithPolymorphicSerializationsFromSource)' != 'true' and '$(HexalithPolymorphicSerializationsFromSource)' != 'false'"
      Code="HXW0001"
      Text="The final HexalithPolymorphicSerializationsFromSource value must be exactly true or false; received '$(HexalithPolymorphicSerializationsFromSource)'." />
    <Error
      Condition="'$(UseHexalithProjectReferences)' == '$(UseNuGetDeps)'"
      Code="HXW0001"
      Text="UseHexalithProjectReferences and UseNuGetDeps must select exactly one dependency mode. Set UseHexalithProjectReferences=true and UseNuGetDeps=false for sibling-source Debug builds, or the inverse for package-mode Release builds." />
    <Error
      Condition="'$(HexalithEventStoreFromSource)' != '$(UseHexalithProjectReferences)'"
      Code="HXW0001"
      Text="HexalithEventStoreFromSource must agree with UseHexalithProjectReferences." />
    <Error
      Condition="'$(HexalithPolymorphicSerializationsFromSource)' != '$(UseHexalithProjectReferences)'"
      Code="HXW0001"
      Text="HexalithPolymorphicSerializationsFromSource must agree with UseHexalithProjectReferences." />
    <Warning
      Condition="'$(HexalithDependencyModeDefaulted)' == 'true'"
      Code="HXW0002"
      Text="No Configuration was specified, so the Hexalith dependency mode defaulted to package references (Release-consistent) while the build emits Debug output. Pass --configuration Debug or Release, or set UseHexalithProjectReferences explicitly." />
  </Target>

  <Target Name="RemoveDuplicateLoggingSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.Gen.Logging'" />
    </ItemGroup>
  </Target>

  <!-- A property-only check cannot protect builds without restore from an older candidate graph.
       Reuse the installed SDK's assets reader to check every restored SDK package, including
       packages without compile assets, before any compilation can consume the graph. -->
  <Target Name="ValidateWorksResolvedEventStorePackages"
          AfterTargets="ResolvePackageAssets" BeforeTargets="CoreCompile"
          DependsOnTargets="ValidateHexalithDependencyMode"
          Condition="'$(Configuration)' == 'Release' and 'candidate:$(WorksAllowLocalEventStoreCandidate)' != 'candidate:true' and Exists('$(ProjectAssetsFile)')">
    <PropertyGroup>
      <_WorksCandidateCachePrefix>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).artifacts/sdk-candidate-packages').Replace('\', '/').ToUpperInvariant())/</_WorksCandidateCachePrefix>
    </PropertyGroup>
    <ResolvePackageDependencies ProjectPath="$(MSBuildProjectFullPath)"
                                ProjectAssetsFile="$(ProjectAssetsFile)"
                                ProjectLanguage="$(Language)"
                                TargetFramework="$(TargetFramework)">
      <Output TaskParameter="PackageDefinitions" ItemName="_WorksResolvedPackages" />
    </ResolvePackageDependencies>
    <Error Condition="'%(_WorksResolvedPackages.Type)' == 'package' and $([System.String]::Copy('%(_WorksResolvedPackages.Name)').ToUpperInvariant().StartsWith('HEXALITH.EVENTSTORE.')) and '%(_WorksResolvedPackages.Version)' != '$(_WorksDeclaredEventStoreVersion)'"
           Code="HXW0003"
           Text="Release assets resolve '%(_WorksResolvedPackages.Identity)' instead of committed EventStore '$(_WorksDeclaredEventStoreVersion)'. Restore Release with the committed pin before building." />
    <Error Condition="'%(_WorksResolvedPackages.Type)' == 'package' and $([System.String]::Copy('%(_WorksResolvedPackages.ResolvedPath)').Replace('\', '/').ToUpperInvariant().StartsWith('$(_WorksCandidateCachePrefix)'))"
           Code="HXW0003"
           Text="Release assets still use the isolated candidate cache for '%(_WorksResolvedPackages.Identity)'. Restore without candidate admission before building." />
  </Target>

</Project>
