<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Runnable Works domain-service host (Story 4.5): the adapter-edge runtime proof that lets
       EventStore invoke the pure Works kernel through Dapr. It is NOT a packable library and NOT
       part of the pure kernel; it is the only Works project allowed to reference EventStore runtime
       / domain-service packages, Dapr, and ASP.NET hosting. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <!-- The telemetry package disables the framework LoggerMessage generator in favor of Microsoft.Gen.Logging,
         while the workspace removes that duplicate analyzer. Re-enable the framework generator for this host. -->
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Works.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure kernel projects consumed unchanged. The host is the adapter edge that drives the pure Reactor
         translators (Story 4.6 cascade dispatch) at runtime; Reactor itself stays pure (references Contracts
         only). -->
    <ProjectReference Include="..\Hexalith.Works.Contracts\Hexalith.Works.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Works.Server\Hexalith.Works.Server.csproj" />
    <ProjectReference Include="..\Hexalith.Works.Projections\Hexalith.Works.Projections.csproj" />
    <ProjectReference Include="..\Hexalith.Works.Reactor\Hexalith.Works.Reactor.csproj" />
    <!-- EventStore domain-service SDK (pulls Client/Contracts/ServiceDefaults transitively). The platform
         service defaults are supplied by AddEventStoreDomainService(); per the EventStore domain-module
         contract (Hexalith.EventStore/CLAUDE.md) a domain module must NOT fork its own ServiceDefaults,
         so Works owns no service-default project. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.DomainService" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithPartiesRoot)\src\Hexalith.Parties.Client\Hexalith.Parties.Client.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <PackageReference Include="Hexalith.Parties.Client" Condition="'$(UseHexalithProjectReferences)' != 'true'" />
  </ItemGroup>


  <!-- Explicit Platform development/qualification fixture only. Ordinary Release and all five
       published Works packages retain no Platform runtime dependency. The dependency must be
       declared before SDK owner preparation; startup-hook injection is not supported. -->
  <PropertyGroup Condition="'$(PlatformWorksRuntimeRoot)' != ''">
    <WorksPlatformRuntimeQualification>synthetic-development-only</WorksPlatformRuntimeQualification>
  </PropertyGroup>
  <ItemGroup Condition="'$(PlatformWorksRuntimeRoot)' != ''">
    <AssemblyMetadata Include="WorksPlatformRuntimeQualification" Value="$(WorksPlatformRuntimeQualification)" />
    <ProjectReference Include="$(PlatformWorksRuntimeRoot)/src/Hexalith.Platform.Works.Runtime/Hexalith.Platform.Works.Runtime.csproj" />
  </ItemGroup>
  <Target Name="ValidateWorksPlatformRuntimeQualification"
          BeforeTargets="ValidateHexalithDependencyMode;PrepareForBuild"
          Condition="'$(PlatformWorksRuntimeRoot)' != ''">
    <Error Condition="!Exists('$(PlatformWorksRuntimeRoot)/src/Hexalith.Platform.Works.Runtime/Hexalith.Platform.Works.Runtime.csproj')"
           Code="HXW0003" Text="PlatformWorksRuntimeRoot must select the existing synthetic Platform Works runtime project." />
  </Target>

</Project>
