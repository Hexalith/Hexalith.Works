<Project>
  <PropertyGroup>
    <!-- Source-only dependencies are absent from the solution configuration map. Keep the
         caller's configuration instead of letting those projects fall back to Debug. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <ItemGroup>
    <!-- Internal solution projects inherit the same global properties as their direct solution
         entries. Adding an SDK version to those edges creates duplicate builds with shared outputs.
         External source dependencies still need the selected SDK version and solution configuration. -->
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties Condition="'%(ProjectReference.Filename)' != 'Hexalith.Works' and !$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Hexalith.Works.'))">%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion);Configuration=$(Configuration);ShouldUnsetParentConfigurationAndPlatform=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <!-- The SDK adds transitive project references during target execution, after the evaluation-time
       update above. Give those edges the same source build identity before configuration assignment. -->
  <Target Name="ForwardWorksTransitiveProjectReferenceProperties" AfterTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(_TransitiveProjectReferences)" Condition="'%(ProjectReference.Filename)' != 'Hexalith.Works' and !$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Hexalith.Works.')) and '%(ProjectReference.AdditionalProperties)' == ''">
        <AdditionalProperties>HexalithEventStoreVersion=$(HexalithEventStoreVersion);Configuration=$(Configuration);ShouldUnsetParentConfigurationAndPlatform=false</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>
</Project>
