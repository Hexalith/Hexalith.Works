+    /// <summary>Old and new shared catalogs retain exactly one approved cryptography pin at the unchanged servicing version.</summary>
+    /// <param name="catalogDeclaresPins">Whether the shared catalog already declares both cryptography packages.</param>
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task AuthorizedCryptographyPinsRemainUniqueAcrossCatalogShapesAsync(bool catalogDeclaresPins)
+    {
+        string root = FindRepositoryRoot();
+        string fixture = Directory.CreateTempSubdirectory("eventstore-cryptography-pins-").FullName;
+        try
+        {
+            string catalog = Path.Combine(fixture, "catalog.props");
+            string[] identities = ["System.Security.Cryptography.Pkcs", "System.Security.Cryptography.Xml"];
+            new XDocument(new XElement("Project", new XElement("ItemGroup", catalogDeclaresPins
+                ? identities.Select(identity => new XElement("PackageVersion", new XAttribute("Include", identity),
+                    new XAttribute("Version", "10.0.12"))) : []))).Save(catalog);
+            XElement pins = new(XDocument.Load(Path.Combine(root, "Directory.Packages.props"))
+                .Root!.Elements("ItemGroup").Single());
+            new XDocument(new XElement("Project", new XElement("Import", new XAttribute("Project", catalog)), pins))
+                .Save(Path.Combine(fixture, "Directory.Packages.props"));
+            string probe = Path.Combine(fixture, "Probe.proj");
+            new XDocument(new XElement("Project", new XElement("Import",
+                new XAttribute("Project", Path.Combine(fixture, "Directory.Packages.props"))))).Save(probe);
+            (int exitCode, string output, string error) = await RunEventStorePackageAuthorityAsync(
+                fixture, catalog, validateWrapperOnly: true).ConfigureAwait(true);
+            exitCode.ShouldBe(0, output + error);
+
+            using Process process = new()
+            {
+                StartInfo = new ProcessStartInfo("dotnet")
+                {
+                    WorkingDirectory = root, RedirectStandardOutput = true, RedirectStandardError = true,
+                    UseShellExecute = false,
+                },
+            };
+            PackagingRepositoryPaths.RemoveRepositorySelectors(process.StartInfo);
+            foreach (string argument in new[] { "msbuild", probe, "-nologo", "-getItem:PackageVersion" })
+            {
+                process.StartInfo.ArgumentList.Add(argument);
+            }
+            process.Start().ShouldBeTrue();
+            Task<string> evaluationTask = process.StandardOutput.ReadToEndAsync();
+            Task<string> errorTask = process.StandardError.ReadToEndAsync();
+            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+            try
+            {
+                await process.WaitForExitAsync(timeout.Token).ConfigureAwait(true);
+            }
+            catch (OperationCanceledException)
+            {
+                process.Kill(entireProcessTree: true);
+                throw;
+            }
+            process.ExitCode.ShouldBe(0, await errorTask.ConfigureAwait(true));
+            using JsonDocument evaluation = JsonDocument.Parse(await evaluationTask.ConfigureAwait(true));
+            JsonElement[] items = [.. evaluation.RootElement.GetProperty("Items").GetProperty("PackageVersion").EnumerateArray()];
+            foreach (string identity in identities)
+            {
+                JsonElement item = items.Single(item => item.GetProperty("Identity").GetString() == identity);
+                item.GetProperty("Version").GetString().ShouldBe("10.0.13");
+            }
+        }
+        finally
+        {
+            Directory.Delete(fixture, recursive: true);
+        }
+    }
