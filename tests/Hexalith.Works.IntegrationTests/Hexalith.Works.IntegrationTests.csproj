<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <WorksPlatformTestRoot Condition="'$(PlatformWorksRuntimeRoot)' != ''">$(PlatformWorksRuntimeRoot)</WorksPlatformTestRoot>
    <WorksPlatformTestRoot Condition="'$(WorksPlatformTestRoot)' == ''">$(HexalithPlatformRoot)</WorksPlatformTestRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WorksSelectedEventStoreVersion" Value="$(HexalithEventStoreVersion)" />
    <AssemblyMetadata Include="WorksPinnedEventStoreVersion" Value="3.126.1" />
    <AssemblyMetadata Include="WorksAllowLocalEventStoreCandidate" Value="$(WorksAllowLocalEventStoreCandidate)" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Works\Hexalith.Works.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Works.Reactor\Hexalith.Works.Reactor.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Works.Server\Hexalith.Works.Server.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Admin.Abstractions\Hexalith.EventStore.Admin.Abstractions.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Admin.Abstractions" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Testing\Hexalith.EventStore.Testing.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Testing" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <!-- Platform test adapters are source-only; neither is a Works production dependency. -->
    <ProjectReference Include="$(HexalithPlatformRoot)\src\Hexalith.Platform.Identity\Hexalith.Platform.Identity.csproj" />
    <ProjectReference Include="$(WorksPlatformTestRoot)\src\Hexalith.Platform.Composition\Hexalith.Platform.Composition.csproj" />
    <ProjectReference Include="..\Hexalith.Works.Testing\Hexalith.Works.Testing.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PlatformWorksRuntimeRoot)' != ''">
    <DefineConstants>$(DefineConstants);WORKS_PLATFORM_PARITY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PlatformWorksRuntimeRoot)' != ''">
    <!-- Explicit target-host proof dependency; it is never selected by the retained consumer build. -->
    <ProjectReference Include="$(PlatformWorksRuntimeRoot)/src/Hexalith.Platform.Works.Runtime/Hexalith.Platform.Works.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact existing Parties authority runtime source, test-only; public Parties.Client/Contracts stay pinned packages. -->
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Authorization/IPartyIdentityAuthority.cs" Link="PartiesAuthority/IPartyIdentityAuthority.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Authorization/PartyIdentityAuthority.cs" Link="PartiesAuthority/PartyIdentityAuthority.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Authorization/PartyIdentityAdmissionResult.cs" Link="PartiesAuthority/PartyIdentityAdmissionResult.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Authorization/PartyIdentityOptions.cs" Link="PartiesAuthority/PartyIdentityOptions.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/PartyIdentityQueryService.cs" Link="PartiesAuthority/PartyIdentityQueryService.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/PartyIdentitySourceFold.cs" Link="PartiesAuthority/PartyIdentitySourceFold.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/PartyIdentityQueryDeadline.cs" Link="PartiesAuthority/PartyIdentityQueryDeadline.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/PartyIdentityQueryWorkLimiter.cs" Link="PartiesAuthority/PartyIdentityQueryWorkLimiter.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/PartyIdentityBindingSelection.cs" Link="PartiesAuthority/PartyIdentityBindingSelection.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/RetainedHumanActorHistoryFold.cs" Link="PartiesAuthority/RetainedHumanActorHistoryFold.cs" />
    <Compile Include="$(HexalithPartiesRoot)/src/Hexalith.Parties/Queries/RetainedHumanActorBinding.cs" Link="PartiesAuthority/RetainedHumanActorBinding.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen Web-reader compatibility corpus (RR-6 / NFR-12): copied verbatim so the
         schema-evolution tests read the exact checked-in historical bytes from test output. -->
    <None Include="SchemaEvolution\Golden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exact options-free EventPersister payload bytes, deliberately separate from the Web fixtures. -->
    <None Include="SchemaEvolution\EventPersisterGolden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exact options-free command payload bytes for additive command-contract changes. -->
    <None Include="SchemaEvolution\CommandGolden\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
