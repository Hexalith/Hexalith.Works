<Project>
  <ItemGroup Condition="'$(HexalithWorksProofAssembly)' != '' and ('$(MSBuildProjectName)' == 'Hexalith.Works' or '$(MSBuildProjectName)' == 'Hexalith.EventStore' or '$(MSBuildProjectName)' == 'Hexalith.EventStore.Admin.Server.Host')">
    <!-- Align this explicit synthetic binary closure with its qualified consumer; CPM overrides remain disabled. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" AssemblyVersion="3.36.1.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" AssemblyVersion="11.0.0.0" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="System.IO.Hashing" />
    <Reference Include="Hexalith.Works.IntegrationTests">
      <HintPath>$(HexalithWorksProofAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- The immutable retained topology reuses independently compiled current net11 reference assemblies. -->
  <ItemGroup Condition="'$(HexalithWorksProofAssembly)' != '' and '$(HexalithWorksRetainedQualification)' == 'true' and '$(MSBuildProjectName)' == 'Hexalith.Works.AppHost'">
    <PackageVersion Remove="Aspire.Hosting.AppHost" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(HexalithAspireAppHostSdkVersion)" />
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(HexalithWorksProofAssembly)' != '' and '$(HexalithWorksRetainedQualification)' == 'true' and ('$(MSBuildProjectName)' == 'Hexalith.Works.AppHost' or '$(MSBuildProjectName)' == 'Hexalith.Works.Contracts' or '$(MSBuildProjectName)' == 'Hexalith.Works.Projections' or '$(MSBuildProjectName)' == 'Hexalith.Works.Reactor' or '$(MSBuildProjectName)' == 'Hexalith.Works.Server' or '$(MSBuildProjectName)' == 'Hexalith.Works.ServiceDefaults')">
    <ProjectReference>
      <SetTargetFramework>TargetFramework=net11.0</SetTargetFramework>
    </ProjectReference>
  </ItemDefinitionGroup>
  <!-- Aspire rebuilds EventStore into the AppHost artifacts directory while the verifier
       serial-prebuilt those projects under WORKS_PLATFORM_RUNTIME_ARTIFACTS and then set
       BuildProjectReferences=false. Stage those outputs before CSC resolves metadata. -->
  <Target Name="HexalithStageQualifiedRuntimeArtifacts"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(HexalithWorksProofAssembly)' != '' and '$(WORKS_PLATFORM_RUNTIME_ARTIFACTS)' != '' and '$(ArtifactsPath)' != '' and '$(BuildProjectReferences)' == 'false'">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../scripts/stage-qualified-runtime-artifacts.sh&quot; &quot;$(WORKS_PLATFORM_RUNTIME_ARTIFACTS)&quot; &quot;$(ArtifactsPath)&quot;"
          Condition="Exists('$(WORKS_PLATFORM_RUNTIME_ARTIFACTS)/obj')"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
