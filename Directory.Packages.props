<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Release restores published EventStore 3.123.0. Platform.Identity has no public package, so tests use its sibling project. -->
    <HexalithEventStoreVersion>3.123.0</HexalithEventStoreVersion>
    <HexalithPartiesVersion>1.2.1</HexalithPartiesVersion>
    <Hexalith1BuildPackageProps>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
    <Hexalith2BuildPackageProps>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</Hexalith2BuildPackageProps>
    <Hexalith3BuildPackageProps>$(MSBuildThisFileDirectory)../../references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith3BuildPackageProps>
  </PropertyGroup>
  <Import Project="$(Hexalith1BuildPackageProps)" Condition="Exists('$(Hexalith1BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith2BuildPackageProps)" Condition="Exists('$(Hexalith2BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith3BuildPackageProps)" Condition="'$(HexalithVersionsLoaded)' != 'true'" />
  <!-- Source Contracts already enters through explicit project edges. Pinning a newer package here
       promotes that transitive package over the source project when sibling release metadata trails.
       Keep all other transitive pins (including security dependencies) and every Release pin intact. -->
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <PackageVersion Remove="Hexalith.EventStore.Contracts" />
  </ItemGroup>
</Project>
