{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "bash scripts/validate-release-secrets.sh && bash scripts/validate-publication-preflight.sh ${nextRelease.version} verify >&2",
        "prepareCmd": "python3 scripts/pack-release-packages.py ./nupkgs ${nextRelease.version} && python3 scripts/validate-nuget-packages.py ./nupkgs && python3 scripts/validate-consumer-package-references.py ./nupkgs",
        "publishCmd": "bash scripts/validate-release-secrets.sh && bash scripts/validate-publication-preflight.sh ${nextRelease.version} publish >&2 && bash scripts/push-release-packages.sh ${nextRelease.version} ./nupkgs"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "nupkgs/*.nupkg",
          "nupkgs/*.snupkg"
        ],
        "labels": [],
        "successCommentCondition": false,
        "releasedLabels": false
      }
    ]
  ]
}
